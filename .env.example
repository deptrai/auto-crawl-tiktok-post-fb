DOWNLOAD_DIR=/app/downloads
GEMINI_API_KEY=
ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_DISPLAY_NAME=Quan tri vien
BASE_URL=https://your-public-domain.example.com
JWT_SECRET=change-me-jwt-secret
TOKEN_ENCRYPTION_SECRET=change-me-token-secret
FB_VERIFY_TOKEN=social_auto_2026
FB_APP_SECRET=
TUNNEL_TOKEN=
AUTH_TOKEN_EXPIRE_MINUTES=480
CORS_ALLOW_ORIGINS=http://localhost:5173
PASSWORD_MIN_LENGTH=8
SCHEDULER_INTERVAL_MINUTES=1
TASK_QUEUE_POLL_SECONDS=5
WORKER_STALE_SECONDS=30
WORKER_BATCH_SIZE=3
SCHEDULER_ENABLED=false
AUTO_CREATE_SCHEMA=false
BACKGROUND_JOBS_MODE=dedicated-worker
APP_ROLE=api
LOG_LEVEL=INFO

# Storage Backend
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
