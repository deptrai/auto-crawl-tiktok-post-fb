# Cleanup
CLEANUP_FAILED_VIDEO_DAYS=7

# Gemini Models (default: stable gemini-2.5-flash; có thể đổi sang
# gemini-3-flash-preview / gemini-3.1-flash-lite-preview nếu chấp nhận
# rủi ro Preview deprecated với 2-week notice + rate limits chặt hơn)
GEMINI_MODEL_CAPTION=gemini-2.5-flash
GEMINI_MODEL_REPLY=gemini-2.5-flash
